{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desk-hud",
  "version": "0.1.0",
  "identifier": "com.axels.desk-hud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "desk-hud",
        "width": 320,
        "height": 300,
        "minWidth": 260,
        "minHeight": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": false,
        "x": 20,
        "y": 20
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
